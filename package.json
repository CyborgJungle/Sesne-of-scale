{
  "name": "sense-of-scale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A daily game about how big, fast, hot, loud and old things really are.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "validate": "node scripts/validate.mjs",
    "verify": "node scripts/verify-sources.mjs",
    "schedule": "node scripts/schedule.mjs",
    "sync": "node --env-file-if-exists=.env scripts/sync.mjs",
    "wikidata": "node scripts/wikidata-draft.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "capacity": "node scripts/capacity.mjs"
  }
}
