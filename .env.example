# Copy to .env for `npm run sync` and for running the dev server against Supabase.
# Without these, the API serves puzzles from schedule/*.json and keeps results in memory (fine for local dev).
# Supabase dashboard → Project Settings → API. Use the *secret* key (or the legacy service_role key). Never expose it to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
